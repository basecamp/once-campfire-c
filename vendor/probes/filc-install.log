 "/opt/fil/bin/ld" --hash-style=gnu --eh-frame-hdr -m elf_x86_64 -nostdlib -pie -dynamic-linker /opt/fil/lib/ld-fil1-x86_64.so -o hello-optfil /opt/fil/lib/Scrt1.o /opt/fil/lib/crti.o /opt/fil/lib/crtbegin.o -L/opt/fil/lib -rpath-link /opt/fil/lib /opt/fil/lib/filc_crt.o /tmp/hello-19fe41.o -lc -lpizlo -lyolort -lyoloc -lyolom -lyolort -lyolounwind /opt/fil/lib/crtend.o /opt/fil/lib/crtn.o
